{
  "$schema": "https://railpack.com/schema.json",
  "name": "scaffold-configurator",
  "providers": {
    "node": {
      "version": "22"
    }
  },
  "packages": {
    "node": "22"
  },
  "build": {
    "steps": [
      {
        "cache": {
          "directories": [
            "node_modules",
            ".next/cache"
          ]
        },
        "commands": [
          "npm install --no-audit --no-fund"
        ]
      },
      {
        "commands": [
          "npm run build"
        ]
      }
    ]
  },
  "start": {
    "cmd": "node .next/standalone/server.js"
  },
  "variables": {
    "NODE_ENV": "production",
    "HOSTNAME": "0.0.0.0",
    "PYTHON_BIN": "python3",
    "GENERATOR_PATH": "/app/scripts/generate_step.py",
    "WORK_DIR": "/app/download",
    "TMP_DIR": "/tmp/scaffold-step-gen"
  }
}
